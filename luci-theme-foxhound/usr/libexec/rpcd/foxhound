case "$1" in
	list)
		echo '{ "temp": {}, "storage": {}, "internet": {}, "vpn_status": {}, "set_about": { "text": "" }, "set_theme": { "mode": "" }, "set_widgets": { "disabled": [], "order": [] }, "check_update": { "force": false }, "finalize_logo": {}, "finalize_login_logo": {}, "finalize_bg_main": {}, "finalize_bg_login": {}, "reset_logo": {}, "reset_login_logo": {}, "reset_bg_main": {}, "reset_bg_login": {} }'
		;;
	call)
		read -r input
		case "$2" in
			temp) rpc_temp ;;
			storage) rpc_storage ;;
			internet) rpc_internet ;;
			vpn_status) rpc_vpn_status ;;
			set_about) rpc_set_about ;;
			set_theme) rpc_set_theme ;;
			set_widgets) rpc_set_widgets ;;
			check_update) rpc_check_update ;;
			finalize_logo) rpc_finalize_logo ;;
			finalize_login_logo) rpc_finalize_login_logo ;;
			finalize_bg_main) rpc_finalize_bg_main ;;
			finalize_bg_login) rpc_finalize_bg_login ;;
			reset_logo) rpc_reset_logo ;;
			reset_login_logo) rpc_reset_login_logo ;;
			reset_bg_main) rpc_reset_bg_main ;;
			reset_bg_login) rpc_reset_bg_login ;;
			*) echo '{}'; exit 1 ;;
		esac
		;;
esac
