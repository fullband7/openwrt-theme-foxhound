{% include('header') %}
{%
	import { cursor } from "uci";
	const uci = cursor();
	const about_text = uci.get("foxhound", "settings", "about_text") || "OpenWRT - Wireless Freedom";
	const theme_mode = uci.get("foxhound", "settings", "theme_mode") || "dark";
%}

<ul class="cbi-tabmenu">
    <li id="tab_logo" class="cbi-tab"><a href="#" onclick="switchTab('logo'); return false;">{{ _('Customization') }}</a></li>
    <li id="tab_update" class="cbi-tab-disabled"><a href="#" onclick="switchTab('update'); return false;">{{ _('Theme Update') }}</a></li>
</ul>

<div id="container_logo" class="cbi-tabcontainer">
    <ul class="cbi-tabmenu">
        <li id="subtab_theme" class="cbi-tab"><a href="#" onclick="switchSubTab('theme'); return false;">{{ _('Look & Feel') }}</a></li>
        <li id="subtab_widget" class="cbi-tab-disabled"><a href="#" onclick="switchSubTab('widget'); return false;">{{ _('Widgets') }}</a></li>
    </ul>
    <div id="subcontainer_theme">
        {% include('foxhound/upload', { about_text: about_text, theme_mode: theme_mode }) %}
    </div>
    <div id="subcontainer_widget" style="display:none;">
        {% include('foxhound/widgets') %}
    </div>
</div>

<div id="container_update" class="cbi-tabcontainer" style="display:none;">
    {% include('foxhound/update') %}
</div>

<script type="text/javascript">
(function(){
    "use strict";
    window.switchTab = function(tabId) {
        var tabs = ['logo', 'update'];
        tabs.forEach(function(t) {
            var tabEl = document.getElementById('tab_' + t);
            var containerEl = document.getElementById('container_' + t);
            if (t === tabId) {
                if (tabEl) tabEl.className = 'cbi-tab';
                if (containerEl) containerEl.style.display = 'block';
            } else {
                if (tabEl) tabEl.className = 'cbi-tab-disabled';
                if (containerEl) containerEl.style.display = 'none';
            }
        });
        localStorage.setItem('foxhound_active_tab', tabId);
    };
    window.switchSubTab = function(subTabId) {
        var subs = ['theme', 'widget'];
        subs.forEach(function(s) {
            var tabEl = document.getElementById('subtab_' + s);
            var containerEl = document.getElementById('subcontainer_' + s);
            if (s === subTabId) {
                if (tabEl) tabEl.className = 'cbi-tab';
                if (containerEl) containerEl.style.display = 'block';
            } else {
                if (tabEl) tabEl.className = 'cbi-tab-disabled';
                if (containerEl) containerEl.style.display = 'none';
            }
        });
        localStorage.setItem('foxhound_active_subtab', subTabId);
    };
    document.addEventListener("DOMContentLoaded", function() {
        var activeTab = localStorage.getItem('foxhound_active_tab') || 'logo';
        switchTab(activeTab);
        var activeSubTab = localStorage.getItem('foxhound_active_subtab') || 'theme';
        switchSubTab(activeSubTab);
    });
}());
</script>

{% include('footer') %}
