{% include('header', { blank_page: true }) %}
{%
	import { cursor } from "uci";
	const uci = cursor();
	const logo_path_re = /^\/luci-static\/foxhound\/resources\/(upload|icons)\/[A-Za-z0-9_-]+\.(png|jpg|jpeg|gif|webp|svg)$/;
	const field_name_re = /^[A-Za-z0-9_-]{1,64}$/;
	const asset_src_re = /^\/[A-Za-z0-9._~%+-][A-Za-z0-9._~\/%+-]*$/;
	const raw_login_logo = uci.get("foxhound", "settings", "login_logo_url");
	const login_logo = (type(raw_login_logo) == "string" && match(raw_login_logo, logo_path_re)) ? raw_login_logo : (media + "/resources/icons/logo.svg");
	const field_types = [ "text", "password", "number", "tel" ];
%}
<section hidden>
<div class="fh-login-wrap">
  <div class="fh-logo">
    <img src="{{ entityencode(login_logo, true) }}" alt="Login Logo">
    <p class="fh-logo-auth">{{ _('Authorization Required') }}</p>
  </div>

  {% if (auth_message): %}
  <div class="fh-error">{{ entityencode(auth_message, true) }}</div>
  {% elif (fuser): %}
  <div class="fh-error">{{ _('Invalid username and/or password! Please try again.') }}</div>
  {% endif %}

  <form method="post">
    <input type="hidden" name="_csrf" value="{{ entityencode(csrf, true) }}">

    <div class="fh-field">
      <span class="fh-field-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="7" r="4"/>
          <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
        </svg>
      </span>
      <input name="luci_username" id="luci_username" type="text"
             autocomplete="username"
             placeholder="{{ _('Username') }}"
             value="{{ entityencode(duser, true) }}">
    </div>

    <div class="fh-field">
      <span class="fh-field-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="11" width="14" height="10" rx="2"/>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        </svg>
      </span>
      <input name="luci_password" id="luci_password" type="password"
             autocomplete="current-password"
             placeholder="{{ _('Password') }}">
    </div>

    {% if (type(auth_fields) == "array"): %}
    {% for (let field in auth_fields): %}
    {% if (type(field?.name) == "string" && match(field.name, field_name_re)): %}
    <div class="fh-field">
      <span class="fh-field-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="11" width="14" height="10" rx="2"/>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        </svg>
      </span>
      <input name="{{ entityencode(field.name, true) }}" id="{{ entityencode(field.name, true) }}"
             type="{{ (field.type in field_types) ? field.type : 'text' }}"
             placeholder="{{ entityencode(_(field.label ?? field.name), true) }}"
             {% if (type(field.inputmode) == "string" && match(field.inputmode, /^[a-z]{1,16}$/)): %} inputmode="{{ field.inputmode }}"{% endif %}
             {% if (type(field.maxlength) == "int" && field.maxlength > 0 && field.maxlength <= 256): %} maxlength="{{ field.maxlength }}"{% endif %}
             {% if (type(field.autocomplete) == "string" && match(field.autocomplete, /^[a-z-]{1,32}$/)): %} autocomplete="{{ field.autocomplete }}"{% endif %}
             {% if (field.required): %} required{% endif %}>
    </div>
    {% endif %}
    {% endfor %}
    {% endif %}

    {% if (auth_html): %}
    <div class="fh-field">{{ auth_html }}</div>
    {% endif %}

    <button type="submit" class="fh-btn">{{ _('Log in') }}</button>
  </form>

</div>

<hr style="display:none">
<button class="btn cbi-button-positive important" style="display:none">{{ _('Log in') }}</button>
</section>

{% if (type(auth_assets) == "array"): %}
{% for (let asset in auth_assets): %}
{% if (asset?.type == "script" && type(asset.src) == "string" && match(asset.src, asset_src_re)): %}
<script src="{{ entityencode(asset.src, true) }}"></script>
{% endif %}
{% endfor %}
{% endif %}

<div id="view">
	<div class="spinning">{{ _('Loading view…') }}</div>
	<script>
		L.require('ui').then(function(ui) {
			ui.instantiateView('foxhound.sysauth');
		});
	</script>
</div>

{% include('footer', { blank_page: true }) %}