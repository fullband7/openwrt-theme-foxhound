		{% if (!blank_page): %}
		</div>
		</div>
		<footer>
			<span>
				{{ _('Powered by') }}
				<a href="https://github.com/openwrt/luci" target="_blank" rel="noopener noreferrer">
					{{ version.luciname }} ({{ version.luciversion }})</a>
				/
				<a href="https://github.com/fullband7/openwrt-theme-foxhound" target="_blank" rel="noopener noreferrer" style="color:var(--footer-fhc)">
					FoxHound Theme v2.4</a>
				{% if (lua_active): %}
					/ {{ _('Lua compatibility mode active') }}
				{% endif %}
			</span>
			<ul class="breadcrumb pull-right fh-modemenu" id="modemenu" style="display:none"></ul>
		</footer>
		<script>L.require('menu-foxhound')</script>
		{% endif %}
	</body>
</html>
