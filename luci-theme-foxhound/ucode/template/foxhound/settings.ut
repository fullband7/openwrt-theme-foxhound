{% include('header') %}
{%
	import { cursor } from "uci";
	const uci = cursor();
	const raw_about_text = uci.get("foxhound", "settings", "about_text");
	const about_text = (type(raw_about_text) == "string" && length(raw_about_text) > 0 && length(raw_about_text) <= 120) ? raw_about_text : "OpenWRT - Wireless Freedom";
	const raw_theme_mode = uci.get("foxhound", "settings", "theme_mode") || "dark";
	const theme_mode = (type(raw_theme_mode) == "string" && match(raw_theme_mode, /^[A-Za-z0-9_-]{1,64}$/)) ? raw_theme_mode : "dark";
%}

<ul class="cbi-tabmenu">
    <li id="tab_logo" class="cbi-tab"><a href="#" data-fh-tab="logo">{{ _('Customization') }}</a></li>
    <li id="tab_update" class="cbi-tab-disabled"><a href="#" data-fh-tab="update">{{ _('Theme Update') }}</a></li>
</ul>

<div id="container_logo" class="cbi-tabcontainer">
    <ul class="cbi-tabmenu">
        <li id="subtab_theme" class="cbi-tab"><a href="#" data-fh-subtab="theme">{{ _('Look & Feel') }}</a></li>
        <li id="subtab_widget" class="cbi-tab-disabled"><a href="#" data-fh-subtab="widget">{{ _('Widgets') }}</a></li>
    </ul>
    <div id="subcontainer_theme">
        {% include('foxhound/custom', { about_text: about_text, theme_mode: theme_mode }) %}
    </div>
    <div id="subcontainer_widget" style="display:none;">
        {% include('foxhound/widgets') %}
    </div>
</div>

<div id="container_update" class="cbi-tabcontainer" style="display:none;">
    {% include('foxhound/update') %}
</div>

<script>(()=>{"use strict";const n=["logo","update"],o=["theme","widget"];let c=!1;const s=t=>{try{return localStorage.getItem(t)}catch{return null}},i=(t,e)=>{try{localStorage.setItem(t,e)}catch{}},d=(t,e,b)=>{for(const a of e){const u=document.getElementById(t+"tab_"+a),h=document.getElementById(t+"container_"+a);u&&(u.className=a===b?"cbi-tab":"cbi-tab-disabled"),h&&(h.style.display=a===b?"block":"none")}};window.switchTab=t=>{n.includes(t)||(t=n[0]),d("",n,t),i("foxhound_active_tab",t),t==="update"&&!c&&typeof window.fhCheck=="function"&&(c=!0,window.fhCheck(!1))},window.switchSubTab=t=>{o.includes(t)||(t=o[0]),d("sub",o,t),i("foxhound_active_subtab",t)},document.addEventListener("click",t=>{const e=t.target.closest("a[data-fh-tab],a[data-fh-subtab]");e&&(t.preventDefault(),e.hasAttribute("data-fh-tab")?window.switchTab(e.dataset.fhTab):window.switchSubTab(e.dataset.fhSubtab))}),document.addEventListener("DOMContentLoaded",()=>{window.switchTab(s("foxhound_active_tab")||"logo"),window.switchSubTab(s("foxhound_active_subtab")||"theme")})})();</script>

{% include('footer') %}
