{% include('header') %}
{%
	import { cursor } from "uci";
	const uci = cursor();
	const raw_about_text = uci.get("foxhound", "settings", "about_text");
	const about_text = (type(raw_about_text) == "string" && length(raw_about_text) > 0 && length(raw_about_text) <= 120) ? raw_about_text : "OpenWRT - Wireless Freedom";
	const raw_theme_mode = uci.get("foxhound", "settings", "theme_mode") || "dark";
	const theme_mode = (type(raw_theme_mode) == "string" && match(raw_theme_mode, /^[A-Za-z0-9_-]{1,64}$/)) ? raw_theme_mode : "dark";
%}

<ul class="cbi-tabmenu">
    <li id="tab_logo" class="cbi-tab"><a href="#" data-fh-tab="logo">{{ _('Customization') }}</a></li>
    <li id="tab_update" class="cbi-tab-disabled"><a href="#" data-fh-tab="update">{{ _('Theme Update') }}</a></li>
</ul>

<div id="container_logo" class="cbi-tabcontainer">
    <ul class="cbi-tabmenu">
        <li id="subtab_theme" class="cbi-tab"><a href="#" data-fh-subtab="theme">{{ _('Look & Feel') }}</a></li>
        <li id="subtab_widget" class="cbi-tab-disabled"><a href="#" data-fh-subtab="widget">{{ _('Widgets') }}</a></li>
    </ul>
    <div id="subcontainer_theme">
        {% include('foxhound/upload', { about_text: about_text, theme_mode: theme_mode }) %}
    </div>
    <div id="subcontainer_widget" style="display:none;">
        {% include('foxhound/widgets') %}
    </div>
</div>

<div id="container_update" class="cbi-tabcontainer" style="display:none;">
    {% include('foxhound/update') %}
</div>

<script type="text/javascript">
(function() {
	"use strict";

	var TABS = [ 'logo', 'update' ];
	var SUBTABS = [ 'theme', 'widget' ];
	var updateChecked = false;

	function sget(key) {
		try { return window.localStorage.getItem(key); } catch (e) { return null; }
	}

	function sset(key, value) {
		try { window.localStorage.setItem(key, value); } catch (e) {}
	}

	function activate(prefix, ids, activeId) {
		ids.forEach(function(id) {
			var tabEl = document.getElementById(prefix + 'tab_' + id);
			var containerEl = document.getElementById(prefix + 'container_' + id);
			if (tabEl) tabEl.className = (id === activeId) ? 'cbi-tab' : 'cbi-tab-disabled';
			if (containerEl) containerEl.style.display = (id === activeId) ? 'block' : 'none';
		});
	}

	window.switchTab = function(tabId) {
		if (TABS.indexOf(tabId) === -1) tabId = TABS[0];
		activate('', TABS, tabId);
		sset('foxhound_active_tab', tabId);
		if (tabId === 'update' && !updateChecked && typeof window.fhCheck === 'function') {
			updateChecked = true;
			window.fhCheck(false);
		}
	};

	window.switchSubTab = function(subTabId) {
		if (SUBTABS.indexOf(subTabId) === -1) subTabId = SUBTABS[0];
		SUBTABS.forEach(function(id) {
			var tabEl = document.getElementById('subtab_' + id);
			var containerEl = document.getElementById('subcontainer_' + id);
			if (tabEl) tabEl.className = (id === subTabId) ? 'cbi-tab' : 'cbi-tab-disabled';
			if (containerEl) containerEl.style.display = (id === subTabId) ? 'block' : 'none';
		});
		sset('foxhound_active_subtab', subTabId);
	};

	document.addEventListener('click', function(ev) {
		var link = ev.target.closest ? ev.target.closest('a[data-fh-tab], a[data-fh-subtab]') : null;
		if (!link) return;
		ev.preventDefault();
		if (link.hasAttribute('data-fh-tab')) window.switchTab(link.getAttribute('data-fh-tab'));
		else window.switchSubTab(link.getAttribute('data-fh-subtab'));
	});

	document.addEventListener('DOMContentLoaded', function() {
		window.switchTab(sget('foxhound_active_tab') || 'logo');
		window.switchSubTab(sget('foxhound_active_subtab') || 'theme');
	});
}());
</script>

{% include('footer') %}
