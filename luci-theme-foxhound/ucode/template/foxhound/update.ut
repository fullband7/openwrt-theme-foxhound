	SPDX-License-Identifier: Apache-2.0
#}
<style>
.fh-patch-body code {background:none; color:var(--color-white)}
.cbi-section svg > text {fill:var(--update-svg-text-color) !important; text-shadow:none !important;}
.fh-page{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:var(--dashboard-text-color);padding:0 0 32px;max-width:900px}
.fh-card{overflow:hidden;margin-bottom:10px}
.fh-dot{width:10px;height:10px;border-radius:50%;display:inline-block;flex-shrink:0;box-shadow:0 0 10px currentColor}
.fh-card-body{padding:24px}
.fh-check-row{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:6px}
.fh-check-btn{display:inline-flex;align-items:center;gap:10px;height:38px;padding:0 18px 0 12px;border:1px solid var(--update-cyan-border-a30);border-radius:10px;background:var(--update-check-btn-bg);color:var(--color-white);font-family:inherit;font-size:14px;font-weight:600;letter-spacing:.2px;line-height:1;white-space:nowrap;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 2px 6px rgba(0,0,0,.18);}
.fh-check-btn:hover{border-color:var(--update-cyan-border-a30);box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 2px 6px rgba(0,0,0,.18)}
.fh-check-btn:focus-visible{outline:2px solid var(--primary-color-high);outline-offset:2px}
.fh-check-btn:disabled{opacity:.6;cursor:progress}
.fh-check-ico{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;flex-shrink:0}
.fh-check-ico svg{display:block;width:18px;height:18px;background:none!important;transition:transform .45s cubic-bezier(.4,0,.2,1)}
.fh-check-btn:hover:not(:disabled) .fh-check-ico svg{transform:rotate(180deg)}
.fh-check-lbl{display:inline-block}
.fh-btn-install{background:var(--success-upload-bg);border:1px solid var(--update-cyan-border-a45);color:var(--color-white);width:100%;justify-content:center;padding:14px 28px;font-size:16px;border-radius:12px;transition:all .25s}
.fh-btn-install:hover{border-color:var(--update-cyan-border-a70)}
.fh-status-box{border-radius:12px;padding:20px 24px;margin-bottom:16px}
.fh-status-uptodate{background:var(--fh-update-bg);border:1px solid var(--update-status-ok-border)}
.fh-status-update{background:var(--fhup-status);border:1px solid var(--update-status-pending-border)}
.fh-status-error{background:var(--update-status-error-bg);border:1px solid var(--update-status-error-border)}
.fh-status-icon{font-size:32px;margin-bottom:20px}
.fh-status-title{font-size:18px;font-weight:700;margin-bottom:12px}
.fh-status-sub{font-size:14px;color:var(--update-muted-text);margin-bottom:12px}
.fh-manual span {font-size:18px;line-height:1.5}
.fh-manual pre {margin-top:15px}
.fh-ver-row{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:16px;background:var(--update-row-bg);border-radius:10px;padding:12px 16px;border:1px solid var(--update-row-border)}
.fh-badge{border-radius:8px;padding:6px 14px;font-size:14px;font-weight:700;letter-spacing:.3px}
.fh-badge-gray{background:var(--update-badge-gray-bg);border:1px solid var(--update-badge-border);color:var(--fhup-color)}
.fh-badge-green{background:var(--update-badge-green-bg);border:1px solid var(--update-badge-green-border);color:var(--update-badge-green-color)}
.fh-badge-cyan{background:var(--update-badge-cyan-bg);border:1px solid var(--update-badge-cyan-border);color:var(--widget-icon-vpn)}
.fh-ver-label{font-size:11px;color:var(--update-dim-text);text-transform:uppercase;letter-spacing:.6px;font-weight:600}
.fh-arrow{color:var(--update-arrow-color);font-size:18px;margin:0 4px}
.fh-patch-box{background:var(--update-row-bg);border:1px solid var(--update-patch-border);border-radius:12px;padding:20px 24px;margin-top:16px}
.fh-patch-header{font-size:13px;font-weight:700;color:var(--update-dim-text);margin-bottom:14px;display:flex;align-items:center;gap:10px}
.fh-patch-header span {color: var(--update-dim-text);}
.fh-patch-ver{background:var(--update-badge-cyan-bg);border:1px solid var(--update-patch-ver-border);border-radius:6px;padding:3px 12px;font-size:14px;color:var(--widget-icon-vpn) !important;font-weight:700}
.fh-patch-body{background:var(--fhup-body);padding:15px;word-break:break-word;font-size:14px;color:var(--fhup-color);line-height:1.8;margin:0;font-family:inherit}
.fh-patch-body code {color:var(--fhup-color)}
.fhup-head{display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background-color:var(--fhup-head); border-bottom: 1px solid var(--pw-panel-bg)}
.fh-output{font-family:'Fira Code',monospace;font-size:13px;color:var(--update-muted-text);white-space:pre-wrap;max-height:200px;overflow-y:auto;background:var(--update-output-bg);border-radius:8px;padding:14px 16px;margin-top:16px;border:1px solid var(--update-output-border)}
.fh-fetching{color:var(--update-dim-text);font-size:14px;margin:12px 0 0;font-style:italic}
.fh-spinner{width:16px;height:16px;border:2px solid var(--update-badge-border);border-top-color:var(--widget-icon-vpn);border-radius:50%;animation:fh-spin .75s linear infinite;display:inline-block;vertical-align:middle;margin-bottom:5px;}
@keyframes fh-spin{to{transform:rotate(360deg)}}
.fh-divider{margin:20px 0;border-top:1px solid var(--update-row-border)}
.fh-md h2, .fh-md h3, .fh-md h1 {background:none !important;border-radius:0;border:none}
.fh-md{padding:16px 20px;font-size:14px;line-height:1.65;color:var(--fhup-color);word-wrap:break-word; border-radius:6px;font-weight:700;}
.fh-md>*:first-child{margin-top:0}
.fh-md>*:last-child{margin-bottom:0}
.fh-md h1,.fh-md h2{font-size:1.35em;font-weight:600;margin:20px 0 12px;padding-bottom:8px;color:var(--update-md-heading-color)}
.fh-md h3{font-size:1.15em;font-weight:600;color:var(--update-md-heading-color)}
.fh-md h4,.fh-md h5,.fh-md h6{font-size:1em;font-weight:600;margin:16px 0 8px;color:var(--update-md-heading-color)}
.fh-md p{margin:0 0 12px; font-weight:700}
.fh-md ul,.fh-md ol{margin:0 0 12px;padding-left:24px}
.fh-md ul{list-style-type:disc}
.fh-md ul ul{list-style-type:circle}
.fh-md ul ul ul{list-style-type:square}
.fh-md ol{list-style-type:decimal}
.fh-md li{margin:4px 0;color:var(--fhup-color)}
.fh-md li.fh-md-task{list-style:none;margin-left:-20px}
.fh-md input[type=checkbox]{margin-right:6px;vertical-align:middle}
.fh-md code{background:var(--update-md-code-bg);padding:.15em .4em;border-radius:6px;font-family:ui-monospace,SFMono-Regular,'SF Mono',Menlo,Consolas,monospace;font-size:15px !important;color:var(--update-md-heading-color); font-weight:700}
.fh-md pre{background:var(--update-md-pre-bg);border:1px solid var(--update-code-border);border-radius:8px;padding:14px 16px;overflow-x:auto;margin:0 0 12px}
.fh-md pre code{background:none;padding:0;font-size:85%;color:var(--update-md-pre-code-color);line-height:1.5}
.fh-md blockquote{margin:0 0 12px;padding:0 1em;color:var(--update-md-quote-color);border-left:.25em solid var(--update-md-quote-border)}
.fh-md blockquote>*:last-child{margin-bottom:0}
.fh-md a{color:var(--update-md-link-color);text-decoration:none}
.fh-md a:hover{text-decoration:underline}
.fh-md img{max-width:100%;border-radius:6px;margin:4px 0;display:block}
.fh-md hr{height:1px;background:var(--update-code-border);border:0;margin:18px 0}
.fh-md strong{font-weight:600;color:var(--update-md-heading-color)}
.fh-md del{color:var(--update-md-quote-color)}
</style>
<div class="fh-page">
  <div class="fh-card">
    <div class="fh-card-body">
      <div class="fh-check-row">
        <button type="button" class="fh-check-btn" id="fh-check-btn">
          <span id="fh-check-ico" class="fh-check-ico" aria-hidden="true"></span>
          <span id="fh-check-lbl" class="fh-check-lbl">{{ _('Check for Update') }}</span>
        </button>
      </div>
      <div id="fh-fetching-msg" style="display:none" class="fh-fetching">Fetching releases page from GitHub…</div>
      <div class="fh-divider"></div>
      <div id="fh-status-area"></div>
      <div id="fh-install-area" style="margin-top:20px"></div>

      <div id="fh-ssh-box" style="display:none; position: relative; margin-top: 12px; border-radius: 6px; overflow: hidden;" data-copy-container>
        <div class="fhup-head">
          <span style="font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace; font-size: 12px;display: flex; align-items: center; gap: 6px;">
            SSH
          </span>
          <button type="button" id="fh-copy-btn" style="display: flex; align-items: center; gap: 6px; padding: 4px 8px; background: transparent; border: 1px solid var(--pw-panel-bg); border-radius: 6px; color: var(--color-white); cursor: pointer; font-size: 12px; font-family: inherit;">
            <span class="copy-text">Copy</span>
          </button>
        </div>
        <pre class="fh-patch-body" style="margin: 0; padding: 16px;color: var(--update-md-pre-code-color); font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace; font-size: 13px; line-height: 1.6; overflow-x: auto; border-radius: 0; border: none;"><code data-copy-target>wget -qO /tmp/foxhound-installer.sh https://raw.githubusercontent.com/fullband7/openwrt-theme-foxhound/main/installer.sh &amp;&amp; sh /tmp/foxhound-installer.sh; rm -f /tmp/foxhound-installer.sh</code></pre>
      </div>

    </div>
  </div>
</div>

