	SPDX-License-Identifier: Apache-2.0
#}
{%
	import { cursor } from "uci";
	const uci = cursor();
	const taskbar_default = [ 'admin/status/logs', 'admin/system/package-manager', 'admin/services/passwall2' ];
	const taskbar_path_re = /^admin\/[A-Za-z0-9_-]+\/[A-Za-z0-9_-]+(\/[A-Za-z0-9_-]+)?$/;
	const taskbar_max_items = 16;
	const taskbar_custom = (uci.get("foxhound", "settings", "taskbar_custom") == "1");
	let taskbar_paths = taskbar_default;
	if (taskbar_custom) {
		let raw_taskbar = uci.get("foxhound", "settings", "taskbar_item") ?? [];
		if (type(raw_taskbar) != "array") raw_taskbar = [raw_taskbar];
		taskbar_paths = [];
		for (let raw_path in raw_taskbar) {
			if (type(raw_path) == "string" && length(raw_path) <= 128 && match(raw_path, taskbar_path_re) && index(taskbar_paths, raw_path) == -1)
				push(taskbar_paths, raw_path);
		}
	}
%}
<style>
.cbi-map,.cbi-section{display:flow-root !important;clear:both !important;width:100% !important;}
.cbi-map .cbi-section-node{display:grid !important;grid-template-columns:repeat(auto-fit,minmax(320px,1fr)) !important;gap:20px !important;background:transparent !important;border:none !important;padding:10px 0 30px 0 !important;width:100% !important;clear:both !important;}
.cbi-value{background:var(--card-bg) !important;border:1px solid var(--upload-card-border) !important;transition: 0.25s ease !important;border-radius:12px !important;padding:0 !important;margin:0 !important;display:flex !important;flex-direction:column !important;overflow:hidden !important;box-shadow:0 4px 12px var(--upload-card-shadow) !important;transition:transform 0.2s ease,box-shadow 0.2s ease;}
.cbi-value:hover{border-color:var(--upload-card-border-hover) !important;box-shadow:0 6px 16px var(--upload-card-shadow-hover) !important;}
.cbi-value-header{background:var(--value-header-bg);border-bottom:1px solid var(--upload-card-border) !important;padding:14px 20px !important;font-size:15px !important;font-weight:600 !important;color:var(--value-header-color);margin:0 !important;width:100% !important;box-sizing:border-box !important;}
.cbi-value-field{padding:20px !important;margin:0 !important;display:flex !important;flex-direction:column !important;gap:12px !important;flex-grow:1 !important;box-sizing:border-box !important;}
#about_text_input + div,#theme_mode_select + div{margin-top:auto !important;}
.fh-tb-card .cbi-value-field{gap:16px !important}
.fh-tb-descr{margin:0;padding:0;font-size:15px;line-height:1.6;color:var(--card-label-color)}
.fh-tb-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.fh-tb-status{display:flex;align-items:center;gap:10px;min-width:0;font-size:12px;color:var(--card-label-color)}
.fh-tb-dirty{color:var(--upload-note-color);font-weight:600}
.fh-tb [hidden]{display:none !important}
.fh-tb button{min-height:40px;margin:0}
.fh-tb-btn-primary{background:var(--button-apply);border:var(--button-apply-border);color:var(--color-white)}
.fh-tb-list{list-style:none;margin:0;padding:10px;display:flex;flex-direction:column;gap:8px;border:1px dashed var(--card-border);border-radius:10px;background:var(--fh-field-input-bg);user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent}
.fh-tb-item{display:flex;align-items:center;gap:10px;min-height:56px;padding:8px 10px;box-sizing:border-box;background:var(--card-bg);border:1px solid var(--card-border);border-radius:8px;transition:border-color .2s ease,box-shadow .2s ease,background .2s ease}
.fh-tb-item.fh-tb-dragging{position:relative;z-index:2;border-color:var(--card-primary);box-shadow:0 10px 24px var(--dragging-shadow-color)}
.fh-tb-item.fh-tb-flash{border-color:var(--card-success);box-shadow:0 0 0 2px var(--card-success)}
.fh-tb-item.fh-tb-missing{opacity:.75}
.fh-tb-index{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 6px;box-sizing:border-box;border-radius:12px;font-size:12px;font-weight:700;color:var(--card-title-color);background:var(--value-header-bg)}
.fh-tb-text{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:2px}
.fh-tb-title{display:flex;align-items:center;gap:8px;min-width:0;font-size:14px;font-weight:600;color:var(--card-title-color)}
.fh-tb-title-text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fh-tb-path{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;direction:ltr;text-align:start;font-size:12px;font-family:monospace;color:var(--card-label-color)}
.fh-tb-badge{flex:0 0 auto;padding:1px 8px;border-radius:10px;font-size:11px;font-weight:600;color:var(--warn-color-high);border:1px solid var(--warn-color-high)}
.fh-tb-handle,.fh-tb-remove{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;min-height:40px;padding:0;border:0;border-radius:8px;background:transparent;color:var(--card-label-color);cursor:pointer;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
.fh-tb-handle{cursor:grab;touch-action:none}
.fh-tb-handle:active{cursor:grabbing}
.fh-tb-list .fh-tb-handle,.fh-tb-list .fh-tb-remove{background:transparent;box-shadow:none}
.fh-tb-list .fh-tb-handle:hover,.fh-tb-list .fh-tb-handle:focus-visible{background:var(--drag-handle-hover-bg)}
.fh-tb-remove:hover,.fh-tb-remove:focus-visible{color:var(--button-remove)}
.fh-tb-handle:focus-visible,.fh-tb-remove:focus-visible{outline:2px solid var(--card-primary);outline-offset:1px}
.fh-tb-handle svg,.fh-tb-remove svg{width:16px;height:16px;fill:currentColor;stroke:none;pointer-events:none}
.fh-tb-remove svg{fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
.fh-tb-empty{margin:0;padding:22px 12px;text-align:center;font-size:13px;color:var(--card-label-color);border:1px dashed var(--card-border);border-radius:10px;background:var(--fh-field-input-bg)}
.fh-tb-actions{display:flex;align-items:center;justify-content:flex-start;gap:10px;flex-wrap:wrap}
.fh-tb-modal{max-width:460px !important}
.fh-tb-modal-title{margin:0 0 4px;font-size:18px;font-weight:700;color:var(--modal-color)}
.fh-tb-modal-text{margin:0 0 12px;padding:0;font-size:13px;line-height:1.6;opacity:.8}
.fh-tb-modal-label{display:block;margin-bottom:6px;font-size:13px;font-weight:600}
.fh-tb-select{display:block;width:100%;min-height:40px;box-sizing:border-box}
.fh-tb-modal-note{margin:8px 0 0;padding:0;font-size:12px;color:var(--upload-note-color)}
.fh-tb-modal .right{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;margin-top:16px}
.fh-tb-modal button{min-height:40px}
.fh-tb-modal-btn-primary{background:var(--button-apply);border:var(--button-apply-border);color:var(--color-white)}
.fh-tb-modal-btn-primary[disabled]{opacity:.5;cursor:not-allowed}
#fh-tb-count {font-size:15px}
html.fh-tb-drag-cursor,html.fh-tb-drag-cursor *{cursor:grabbing !important}
@media (max-width:480px){.fh-tb-path{display:none}.fh-tb-actions{flex-direction:column-reverse;align-items:stretch;width:100%}.fh-tb-actions button{width:100%}}
</style>
<div class="cbi-map">
    <div class="cbi-map-descr">
	<span style="color:var(--upload-note-color);">Note :</span> Logos support PNG, JPG/JPEG, GIF and WEBP. Backgrounds support only JPG/JPEG. Maximum upload size is 2MB.
	</div>

    <div class="cbi-section">
        <div class="cbi-section-node">

            <div class="cbi-value">
            <div class="cbi-value-header">Header Bio</div>
            <div class="cbi-value-field">
                <textarea id="about_text_input"
                          rows="1"
                          maxlength="30"
                          style="width:70%;height:70px;padding:5px; resize:none; background:var(--upload-textarea-bg); color:inherit;border-radius:3px;">{{ entityencode(about_text ?? "", true) }}</textarea>
                <div style="margin-top: 8px;">
                    <button type="button" id="save_about_btn"
                            style="background:var(--button-apply);border:var(--button-apply-border);color:var(--color-white)"
                            class="cbi-button cbi-button-apply">Apply Changes</button>
                </div>
            </div>
            </div>

            <div class="cbi-value">
            <div class="cbi-value-header">Color Mode</div>
            <div class="cbi-value-field">
                {%
                    let default_palette_id = theme_mode ?? "dark";
                    let default_palette_label = length(default_palette_id)
                        ? `${uc(substr(default_palette_id, 0, 1))}${substr(default_palette_id, 1)}`
                        : "Dark";
                %}
                <select id="theme_mode_select" class="cbi-input-select" data-current-palette="{{ entityencode(default_palette_id, true) }}">
                    <option value="{{ entityencode(default_palette_id, true) }}" selected>{{ entityencode(default_palette_label, true) }}</option>
                </select>
                <div style="margin-top: 8px;">
                    <button type="button" id="theme_apply_btn" style="background:var(--button-apply);border:var(--button-apply-border);color:var(--color-white)" class="cbi-button cbi-button-apply">Apply</button>
                </div>
            </div>
            </div>

            <div class="cbi-value">
                <div class="cbi-value-header">Header Logo</div>
                <div class="cbi-value-field">
                    <div>
                        <button type="button" id="upload_main_btn" style="background:var(--button-apply);border:var(--button-apply-border);color:var(--color-white)" class="cbi-button cbi-button-apply">Upload</button>
                        <button type="button" id="reset_main_btn" class="cbi-button cbi-button-remove" style="margin-left: 5px;color:var(--color-white)">Reset to Default</button>
                    </div>
                </div>
            </div>

            <div class="cbi-value">
                <div class="cbi-value-header">Login Page Logo</div>
                <div class="cbi-value-field">
                    <div>
                        <button type="button" id="upload_login_btn" style="background:var(--button-apply);border:var(--button-apply-border);color:var(--color-white)" class="cbi-button cbi-button-apply">Upload</button>
                        <button type="button" id="reset_login_btn" class="cbi-button cbi-button-remove" style="margin-left: 5px;color:var(--color-white)">Reset to Default</button>
                    </div>
                </div>
            </div>

            <div class="cbi-value">
                <div class="cbi-value-header">Dashboard Wallpaper</div>
                <div class="cbi-value-field">
                    <div>
                        <button type="button" id="upload_bg_main_btn" style="background:var(--button-apply);border:var(--button-apply-border);color:var(--color-white)" class="cbi-button cbi-button-apply">Upload</button>
                        <button type="button" id="reset_bg_main_btn" class="cbi-button cbi-button-remove" style="margin-left: 5px;color:var(--color-white)">Remove</button>
                    </div>
                </div>
            </div>

            <div class="cbi-value">
                <div class="cbi-value-header">Login Wallpaper</div>
                <div class="cbi-value-field">
                    <div>
                        <button type="button" id="upload_bg_login_btn" style="background:var(--button-apply);border:var(--button-apply-border);color:var(--color-white)" class="cbi-button cbi-button-apply">Upload</button>
                        <button type="button" id="reset_bg_login_btn" class="cbi-button cbi-button-remove" style="margin-left: 5px;color:var(--color-white)">Remove</button>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>
<div class="cbi-map fh-tb" id="fh-tb" data-items="{{ entityencode(join(' ', taskbar_paths), true) }}" data-max="{{ taskbar_max_items }}">
    <div class="cbi-section">
        <div class="cbi-section-node">
            <div class="cbi-value fh-tb-card">
                <div class="cbi-value-header">{{ _('Taskbar') }}</div>
                <div class="cbi-value-field">
                    <p class="fh-tb-descr">{{ _('Choose which pages appear in the sidebar taskbar and drag the handle to change their order.') }}</p>
                    <div class="fh-tb-toolbar">
                        <button type="button" id="fh-tb-add" class="cbi-button cbi-button-action fh-tb-btn-primary">+ {{ _('Add new menu') }}</button>
                        <div class="fh-tb-status">
                            <span id="fh-tb-dirty" class="fh-tb-dirty" hidden>{{ _('Unsaved changes') }}</span>
                            <span id="fh-tb-count" aria-live="polite"></span>
                        </div>
                    </div>
                    <ul id="fh-tb-list" class="fh-tb-list" aria-label="{{ _('Taskbar items') }}"></ul>
                    <p id="fh-tb-empty" class="fh-tb-empty" hidden>{{ _('The taskbar is empty. Use "Add new menu" to add a page.') }}</p>
                    <div class="fh-tb-actions">
					    <button type="button" id="fh-tb-save" class="cbi-button cbi-button-apply fh-tb-btn-primary">{{ _('Save & Apply') }}</button>
                        <button type="button" id="fh-tb-reset" class="cbi-button cbi-button-remove" style="color:var(--color-white)">{{ _('Reset to Default') }}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
